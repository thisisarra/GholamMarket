<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "مدیریت") - غلام‌مارکت</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <aside class="col-lg-2 admin-side p-3">
                <a class="brand-mark d-block fs-5 mb-4" asp-area="Admin" asp-page="/Index">مدیریت فروشگاه</a>
                <a class="d-block rounded p-2" asp-area="Admin" asp-page="/Index"><i class="bi bi-speedometer2"></i> پیشخوان</a>
                <a class="d-block rounded p-2" asp-area="Admin" asp-page="/Products/Index"><i class="bi bi-box"></i> کالاها</a>
                <a class="d-block rounded p-2" asp-area="Admin" asp-page="/Categories/Index"><i class="bi bi-grid"></i> دسته‌ها</a>
                <a class="d-block rounded p-2" asp-area="Admin" asp-page="/Orders/Index"><i class="bi bi-receipt"></i> سفارش‌ها</a>
                <a class="d-block rounded p-2" asp-area="Admin" asp-page="/Users/Index"><i class="bi bi-people"></i> کاربران</a>
                <a class="d-block rounded p-2 mt-4" asp-area="" asp-page="/Index"><i class="bi bi-shop"></i> فروشگاه</a>
            </aside>
            <section class="col-lg-10 p-4">
                <partial name="_Alerts" />
                @RenderBody()
            </section>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
