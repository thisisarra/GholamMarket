@model int
@{
    var count = (int)(ViewData["PageCount"] ?? 1);
    if (count <= 1) return;
}
<nav class="mt-4" aria-label="صفحه‌بندی">
    <ul class="pagination">
        @for (var i = 1; i <= count; i++)
        {
            var values = ViewContext.HttpContext.Request.Query.ToDictionary(pair => pair.Key, pair => (string?)pair.Value.ToString(), StringComparer.OrdinalIgnoreCase);
            values["page"] = i.ToString();
            var href = ViewContext.HttpContext.Request.PathBase + ViewContext.HttpContext.Request.Path + QueryString.Create(values);
            <li class="page-item @(i == Model ? "active" : null)"><a class="page-link" href="@href">@i.ToString("0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR"))</a></li>
        }
    </ul>
</nav>
