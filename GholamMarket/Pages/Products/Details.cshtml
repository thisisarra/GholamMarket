@page "{slug}"
@model GholamMarket.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "کالا";
    var product = Model.Product!;
    var available = product.Stock > 0;
    var discounted = product.DiscountPercent is > 0;
}

<div class="surface p-3 p-md-4">
    <div class="detail-grid">
        <div class="product-media product-media-detail">
            @if (string.IsNullOrWhiteSpace(product.ImageUrl))
            {
                <span class="media-fallback" aria-hidden="true"><i class="bi bi-image"></i></span>
            }
            else
            {
                <img data-product-image src="@product.ImageUrl" alt="@product.Name" />
            }
            @if (discounted)
            {
                <span class="discount-badge">@product.DiscountPercent?.ToString("0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR"))٪ تخفیف</span>
            }
        </div>
        <div>
            <a class="category-chip" asp-page="/Products/Index" asp-route-category="@product.CategorySlug">@product.CategoryName</a>
            <h1 class="h3 mt-3 mb-2">@product.Name</h1>
            <div class="product-price mb-2">
                <span class="price fs-3">@ShopFormat.Money(product.FinalPrice)</span>
                @if (discounted)
                {
                    <span class="old-price">@ShopFormat.Money(product.Price)</span>
                }
            </div>
            <p class="stock @(available ? "in" : "out")">@(available ? $"موجود در انبار: {product.Stock}" : "این کالا فعلاً موجود نیست.")</p>
            @if (!string.IsNullOrWhiteSpace(product.Description))
            {
                <p class="mt-3 mb-0">@product.Description</p>
            }
            @if (product.Attributes.Count > 0)
            {
                <ul class="attr-list">
                    @foreach (var spec in product.Attributes)
                    {
                        <li><span>@spec.Name</span><strong>@spec.Value</strong></li>
                    }
                </ul>
            }
            <form method="post" class="mt-4">
                <div class="qty-form">
                    <label class="form-label mb-0" asp-for="Quantity">تعداد</label>
                    <input class="form-control" asp-for="Quantity" min="1" max="@Math.Max(product.Stock, 1)" />
                    <button class="btn btn-brand" type="submit" @(available ? null : "disabled")>افزودن به سبد</button>
                </div>
                <span class="field-error" asp-validation-for="Quantity"></span>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
