@page "{id:int}"
@model GholamMarket.Pages.Account.Orders.DetailsModel
@using Domain.Entities.Sales
@{
    Layout = "_UserLayout";
    var order = Model.Order!;
    ViewData["Title"] = order.OrderNumber;
    var steps = new[] { OrderStatus.Pending, OrderStatus.Paid, OrderStatus.Processing, OrderStatus.Shipped, OrderStatus.Delivered };
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h4">سفارش @order.OrderNumber</h1>
        <div class="text-secondary">@ShopFormat.When(order.CreatedAt)</div>
    </div>
    <span class="badge @ShopFormat.Badge(order.Status)">@ShopFormat.OrderStatus(order.Status)</span>
</div>

@if (order.Status is not OrderStatus.Cancelled and not OrderStatus.Refunded)
{
    <div class="progress-track mb-3">
        @foreach (var step in steps)
        {
            var done = (int)order.Status >= (int)step;
            <span class="@(order.Status == step ? "current" : done ? "done" : null)">@ShopFormat.OrderStatus(step)</span>
        }
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="surface p-3">
            <table class="table">
                <thead><tr><th>کالا</th><th>تعداد</th><th>قیمت</th><th>جمع</th></tr></thead>
                <tbody>
                @foreach (var line in order.Lines)
                {
                    <tr>
                        <td>@line.ProductName <div class="small text-secondary">@line.Sku</div></td>
                        <td>@line.Quantity</td>
                        <td>@ShopFormat.Money(line.Price)</td>
                        <td>@ShopFormat.Money(line.LineTotal)</td>
                    </tr>
                }
                </tbody>
            </table>
            <div>جمع کالا: @ShopFormat.Money(order.Subtotal)</div>
            <div>تخفیف: @ShopFormat.Money(order.DiscountAmount)</div>
            <div>ارسال: @ShopFormat.Money(order.ShippingAmount)</div>
            <div class="price">مبلغ نهایی: @ShopFormat.Money(order.TotalAmount)</div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="surface p-3 mb-3">
            <h2 class="h6">تحویل</h2>
            <div>@order.ReceiverName - @order.ReceiverPhone</div>
            <div>@order.Province، @order.City، @order.Street @order.Plaque</div>
            <div>کد پستی @order.PostalCode</div>
            @if (!string.IsNullOrWhiteSpace(order.TrackingCode))
            {
                <div class="mt-2">کد رهگیری: @order.TrackingCode</div>
            }
        </div>
        <div class="surface p-3">
            <div>پرداخت: @ShopFormat.PaymentStatus(order.PaymentStatus)</div>
            @if (order.Status == OrderStatus.Pending)
            {
                <a class="btn btn-brand w-100 my-2" asp-page="/Checkout/Pay" asp-route-orderId="@order.Id">پرداخت</a>
                <form method="post" asp-page-handler="Cancel">
                    <button class="btn btn-outline-danger w-100" type="submit">لغو سفارش</button>
                </form>
            }
        </div>
    </div>
</div>
