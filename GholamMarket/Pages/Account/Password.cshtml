@page
@model GholamMarket.Pages.Account.PasswordModel
@{
    Layout = "_UserLayout";
    ViewData["Title"] = "تغییر رمز";
}

<form class="surface p-4" method="post">
    <h1 class="h4 mb-3">تغییر رمز عبور</h1>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">رمز فعلی</label>
        <input class="form-control" asp-for="CurrentPassword" type="password" />
        <span class="text-danger" asp-validation-for="CurrentPassword"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">رمز جدید</label>
        <input class="form-control" asp-for="NewPassword" type="password" />
        <div class="form-text">حداقل ۶ کاراکتر، حرف بزرگ و کوچک، عدد و نماد.</div>
        <span class="text-danger" asp-validation-for="NewPassword"></span>
    </div>
    <button class="btn btn-brand" type="submit">تغییر رمز</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
