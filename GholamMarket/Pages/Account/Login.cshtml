@page
@model GholamMarket.Pages.Account.LoginModel
@{
    ViewData["Title"] = "ورود";
}

<div class="auth-layout">
    <form class="surface auth-card" method="post">
        <h2 class="h4 mb-3">ورود به حساب</h2>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3">
            <label class="form-label" asp-for="Identifier">ایمیل یا موبایل</label>
            <input class="form-control" asp-for="Identifier" />
            <span class="field-error" asp-validation-for="Identifier"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Password">رمز عبور</label>
            <input class="form-control" asp-for="Password" type="password" />
            <span class="field-error" asp-validation-for="Password"></span>
        </div>
        <button class="btn btn-brand w-100" type="submit">ورود</button>
        <p class="mt-3 mb-0">حساب ندارید؟ <a asp-page="/Account/Register">ثبت‌نام</a></p>
    </form>
    <aside class="auth-aside">
        <h1 class="h3">ورود به غلام‌مارکت</h1>
        <p>سفارش‌ها، آدرس‌ها و پیگیری ارسال در حساب شما نگه داشته می‌شود.</p>
    </aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
