@page
@model GholamMarket.Pages.Account.ProfileModel
@{
    Layout = "_UserLayout";
    ViewData["Title"] = "اطلاعات حساب";
}

<form class="surface p-4" method="post">
    <h1 class="h4 mb-3">اطلاعات حساب</h1>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">نام</label>
            <input class="form-control" asp-for="Input.FirstName" />
            <span class="text-danger" asp-validation-for="Input.FirstName"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">نام خانوادگی</label>
            <input class="form-control" asp-for="Input.LastName" />
            <span class="text-danger" asp-validation-for="Input.LastName"></span>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">ایمیل</label>
        <input class="form-control" asp-for="Input.Email" />
        <span class="text-danger" asp-validation-for="Input.Email"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">موبایل</label>
        <input class="form-control" asp-for="Input.Phone" />
        <span class="text-danger" asp-validation-for="Input.Phone"></span>
    </div>
    <button class="btn btn-brand" type="submit">ذخیره</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
